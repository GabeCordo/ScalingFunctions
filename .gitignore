################################################
#               Generic Exclusions
################################################

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
build/

# Test binary, built with `go test -c`
*.test

# MacOS metadata files
.DS_Store

################################################
#          Development IDE Exclusions
################################################

# Goland + VSCode dependencies (pulling will throw an error if this is being tracked)
.idea/
.vscode

################################################
#               Golang Exclusions
################################################

# Output of the go coverage tool, specifically when used with LiteIDE
*.out
*.html

# Coverage reports generated by go
.out

################################################
#               Python Exclusions
################################################

# Python virtual environment folders
.venv